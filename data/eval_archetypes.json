      "genres": [
        "pop",
        "indie-pop",
        "k-pop",
        "synth-pop",
        "country",
        "singer-songwriter"
      ]
    },
    {
      "name": "Sophisticated",
      "genres": [
        "blues",
        "jazz",
        "bluegrass",
        "folk",
        "classical",
        "gospel",
        "piano"
      ]
    },
    {
      "name": "Intense",
      "genres": [
        "rock",
        "punk-rock",
        "heavy-metal",
        "hard-rock",
        "alt-rock",
        "indie"
      ]
    },
    {
      "name": "Contemporary",
      "genres": [
        "hip-hop",
        "r-n-b",
        "soul",
        "funk",
        "reggae",
        "reggaeton",
        "dancehall",
        "ska",
        "disco"
      ]
    }
  ],
