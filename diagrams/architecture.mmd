flowchart TD
    taste["Your taste<br/>genre, mood, energy, acoustic, sound targets"]
    liked["Songs you already like (optional)"]
    catalog["Catalog<br/>50-song demo or 1,985 songs"]
    retr["1. Retrieval<br/>genre AND mood, then OR, then all<br/>(skipped when songs are liked)"]
    score["2. Scoring<br/>points per factor, incl. similarity to liked songs"]
    div["3. Diversity ranking<br/>artist-repeat penalty, top k"]
    rules["4. Rule-based explanation"]
    llm["AI writer (optional)<br/>facts of one pick only"]
    guard{"Guardrail<br/>text vs score breakdown"}
    cards["Result cards<br/>score bar + explanation"]

    taste --> retr
    liked --> score
    catalog --> score
    retr --> score --> div --> rules
    div -- facts --> llm --> guard
    guard -- passes --> cards
    guard -- fails --> rules
    rules -- fallback / AI off --> cards

    subgraph Evidence
      e1["Baselines and ablation"]
      e2["Weight tuning and sensitivity"]
      e3["Synthetic listeners: genre taste, audio taste (MUSIC-model archetypes)"]
      e4["Real listeners: opt-in taste files"]
      e5["Guardrail test suite"]
    end
