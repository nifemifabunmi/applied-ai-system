flowchart LR
    subgraph User["User-facing applications"]
        U["User preferences<br/>genre, mood, energy<br/>optional liked songs"]
        APP["Streamlit app<br/>catalog picker"]
        CLI["Command-line demo"]
        U --> APP
        U --> CLI
    end

    subgraph Data["Catalog data"]
        SMALL[("Small demo<br/>50 songs")]
        LARGE[("Large catalog<br/>1,985 songs")]
        APP --> SMALL
        APP --> LARGE
        CLI --> SMALL
    end

    subgraph Core["Shared recommender - src/recommender.py"]
        LOAD["Load selected catalog"]
        RETRIEVE["Retrieve candidates<br/>genre/mood filter + relaxation<br/>or full catalog with liked songs"]
        SCORE["Score candidates<br/>rules + optional liked-song similarity"]
        DIVERSE["Rank with artist diversity"]
        EXPLAIN["Explain recommendations"]
        LOAD --> RETRIEVE --> SCORE --> DIVERSE --> EXPLAIN
    end

    SMALL --> LOAD
    LARGE --> LOAD
    APP -->|"preferences + liked IDs"| RETRIEVE
    CLI -->|"profile"| RETRIEVE
    EXPLAIN --> OUT["Recommendations<br/>scores, reasons, retrieval details"]

    subgraph Evaluation["Offline experiments - not used by the app"]
        ARCH["Synthetic archetypes<br/>10 groups, 60 listener draws"]
        EXP["v1–v4 baselines,<br/>ablations & trade-off tests"]
        METRICS["Metrics + grouped validation"]
        REPORT["Reports<br/>reports/*.md"]
        ARCH --> EXP --> METRICS --> REPORT
        LARGE -. "evaluation catalog" .-> EXP
    end

    BUILD["Optional catalog builder<br/>scripts/build_catalog.py<br/>external source CSV"]
    BUILD -. "builds" .-> LARGE

    classDef input fill:#f3e8ff,stroke:#7e22ce,color:#1f1235
    classDef data fill:#e0f2fe,stroke:#0369a1,color:#082f49
    classDef process fill:#dcfce7,stroke:#15803d,color:#052e16
    classDef output fill:#fef3c7,stroke:#b45309,color:#451a03
    class U,APP,CLI input
    class SMALL,LARGE,ARCH data
    class LOAD,RETRIEVE,SCORE,DIVERSE,EXPLAIN,EXP,METRICS,BUILD process
    class OUT,REPORT output
